---
import { BASE } from '../site.config';

interface Props {
  id: string;
  title: string;
  description: string;
  date: Date;
  topics?: string[];
}

const { id, title, description, date, topics } = Astro.props;

const dateStr = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const dateIso = date.toISOString().slice(0, 10);
---

<li class="article-card">
  <time class="article-card__date" datetime={dateIso}>{dateStr}</time>
  <div class="article-card__body">
    <h2 class="article-card__title">
      <a href={`${BASE}blog/${id}`}>{title}</a>
    </h2>
    <p class="article-card__desc">{description}</p>
    {topics && topics.length > 0 && (
      <ul class="article-card__topics">
        {topics.map((t) => (
          <li class="article-card__topic">{t}</li>
        ))}
      </ul>
    )}
  </div>
</li>
