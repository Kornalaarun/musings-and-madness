---
import { getCollection } from 'astro:content';
import { BASE } from '../../site.config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && !data.placeholder);
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = allPosts.filter((p) => !p.data.topics?.includes('bites'));
const bites = allPosts.filter((p) => p.data.topics?.includes('bites'));

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
function fmtShort(d: Date) {
  return d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Commonplace Book — Sample Layout</title>
  <style>
    :root {
      --bg: #f6f1e8;
      --panel: #ede7d8;
      --panel-dark: #e3dac8;
      --text: #2c2015;
      --mid: #5c4a35;
      --muted: #9a8570;
      --accent: #7a4e32;
      --accent-warm: #b06a40;
      --border: #c8b89a;
      --border-light: #ddd0bb;
      --serif: Georgia, 'Times New Roman', serif;
      --sans: system-ui, -apple-system, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--serif);
      font-size: 1rem;
      line-height: 1.7;
      min-height: 100vh;
    }

    .container {
      max-width: 54rem;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ── Header ──────────────────────────────────── */
    .site-header {
      padding: 3rem 0 2.5rem;
      border-bottom: 2px solid var(--border);
      margin-bottom: 3rem;
    }

    .header-inner {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .brand {
      display: block;
    }

    .brand-title {
      font-family: var(--serif);
      font-size: 1.5rem;
      font-weight: normal;
      letter-spacing: -0.01em;
      color: var(--text);
      text-decoration: none;
    }

    .brand-sub {
      font-family: var(--sans);
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.04em;
      margin-top: 0.15rem;
    }

    .site-nav {
      display: flex;
      gap: 1.75rem;
      list-style: none;
      align-items: center;
    }

    .site-nav a {
      font-family: var(--sans);
      font-size: 0.78rem;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: 0.05em;
    }
    .site-nav a:hover { color: var(--accent); }

    /* ── Section shelf ───────────────────────────── */
    .shelf {
      margin-bottom: 3.5rem;
    }

    .shelf-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    .shelf-title {
      font-family: var(--sans);
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent);
      font-weight: 500;
      white-space: nowrap;
    }

    .shelf-rule {
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .shelf-count {
      font-family: var(--sans);
      font-size: 0.65rem;
      color: var(--muted);
      white-space: nowrap;
    }

    /* ── Writing cards ───────────────────────────── */
    .writing-list { list-style: none; display: flex; flex-direction: column; gap: 0; }

    .writing-card {
      background: var(--panel);
      border: 1px solid var(--border-light);
      padding: 1.25rem 1.5rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 1rem;
      align-items: start;
      border-bottom: none;
    }
    .writing-card:first-child { border-top-left-radius: 2px; border-top-right-radius: 2px; }
    .writing-card:last-child {
      border-bottom: 1px solid var(--border-light);
      border-bottom-left-radius: 2px;
      border-bottom-right-radius: 2px;
    }
    .writing-card + .writing-card { border-top: 1px solid var(--border-light); }
    .writing-card:hover { background: var(--panel-dark); }

    .card-topics {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin-bottom: 0.4rem;
    }
    .card-topic {
      font-family: var(--sans);
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 0.1em 0.5em;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: normal;
      margin-bottom: 0.3rem;
      line-height: 1.35;
    }
    .card-title a {
      color: var(--text);
      text-decoration: none;
    }
    .card-title a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    .card-desc {
      font-size: 0.82rem;
      color: var(--mid);
      line-height: 1.6;
    }

    .card-date {
      font-family: var(--sans);
      font-size: 0.68rem;
      color: var(--muted);
      white-space: nowrap;
      text-align: right;
      padding-top: 0.2em;
    }

    /* ── Notes grid ──────────────────────────────── */
    .notes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
      gap: 1px;
      background: var(--border-light);
      border: 1px solid var(--border-light);
    }

    .note-card {
      background: var(--panel);
      padding: 1rem 1.25rem;
    }
    .note-card:hover { background: var(--panel-dark); }

    .note-title {
      font-size: 0.9rem;
      font-weight: normal;
      margin-bottom: 0.25rem;
      line-height: 1.4;
    }
    .note-title a {
      color: var(--text);
      text-decoration: none;
    }
    .note-title a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }

    .note-date {
      font-family: var(--sans);
      font-size: 0.65rem;
      color: var(--muted);
    }

    /* ── Footer ───────────────────────────────────── */
    .site-footer {
      border-top: 2px solid var(--border);
      padding: 2rem 0 3rem;
      margin-top: 3rem;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-copy {
      font-family: var(--sans);
      font-size: 0.72rem;
      color: var(--muted);
    }

    .footer-tagline {
      font-style: italic;
      font-size: 0.85rem;
      color: var(--muted);
    }

    /* ── Back ─────────────────────────────────────── */
    .back {
      font-family: var(--sans);
      font-size: 0.7rem;
      color: var(--muted);
      text-decoration: none;
      display: block;
      padding-top: 1.5rem;
      margin-bottom: 1rem;
    }
    .back:hover { color: var(--accent); }

    @media (max-width: 36rem) {
      .notes-grid { grid-template-columns: 1fr; }
      .writing-card { grid-template-columns: 1fr; }
      .card-date { text-align: left; }
    }
  </style>
</head>
<body>
  <div class="container">
    <a class="back" href=".">&larr; samples</a>

    <header class="site-header">
      <div class="header-inner">
        <div class="brand">
          <a class="brand-title" href="#">Musings and Madness</a>
          <p class="brand-sub">A personal commonplace book</p>
        </div>
        <nav>
          <ul class="site-nav">
            <li><a href="#">Writing</a></li>
            <li><a href="#">Notes</a></li>
            <li><a href="#">Reading</a></li>
            <li><a href="#">About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <section class="shelf">
        <div class="shelf-header">
          <span class="shelf-title">Writing</span>
          <div class="shelf-rule"></div>
          <span class="shelf-count">{posts.length} pieces</span>
        </div>
        <ul class="writing-list">
          {posts.map((post) => (
            <li class="writing-card">
              <div>
                {post.data.topics && (
                  <ul class="card-topics">
                    {post.data.topics.filter(t => t !== 'bites').map(t => (
                      <li class="card-topic">{t}</li>
                    ))}
                  </ul>
                )}
                <h2 class="card-title">
                  <a href={`${BASE}blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="card-desc">{post.data.description}</p>
              </div>
              <div class="card-date">{fmtDate(post.data.originalDate ?? post.data.date)}</div>
            </li>
          ))}
        </ul>
      </section>

      {bites.length > 0 && (
        <section class="shelf">
          <div class="shelf-header">
            <span class="shelf-title">Short Notes</span>
            <div class="shelf-rule"></div>
            <span class="shelf-count">{bites.length} notes</span>
          </div>
          <div class="notes-grid">
            {bites.map((post) => (
              <div class="note-card">
                <p class="note-title">
                  <a href={`${BASE}blog/${post.id}`}>{post.data.title}</a>
                </p>
                <p class="note-date">{fmtShort(post.data.originalDate ?? post.data.date)}</p>
              </div>
            ))}
          </div>
        </section>
      )}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-copy">&copy; {new Date().getFullYear()} Arun</span>
        <span class="footer-tagline">collect, read, think</span>
      </div>
    </footer>
  </div>
</body>
</html>
