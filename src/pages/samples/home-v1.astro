---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SITE, BASE } from '../../site.config';
import { projects } from '../../data/projects';

const isDev = import.meta.env.DEV;

const allPosts = await getCollection('blog', ({ data }) => {
  if (data.draft && !isDev) return false;
  return true;
});

allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = allPosts.filter((p) => !p.data.topics?.includes('bites'));
const bites = allPosts.filter((p) => p.data.topics?.includes('bites')).slice(0, 3);

const featuredPosts = posts.slice(0, 4);
const featuredProjects = projects.slice(0, 4);

const currently = {
  reading: ['Palace of Illusions', 'The Beginning of Infinity', 'Domain-Driven Design'],
  building: ['AI storytelling + trivia channels', 'Lease document intelligence portal', 'Dessert map of Hyderabad'],
  seeking: ['Foundational research - ₹2L budget'],
};

function fmtShort(d: Date) {
  return d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <div class="container">
    <section class="home">

      <div class="home__intro">
        <h1 class="home__title">Musings<br />and Madness</h1>
        <p class="home__tagline">
          Writer, programmer, chess player, science optimist, storyteller.
          I don't like being put in boxes. I always wanted to be more than
          the world would allow - and with AI, I can be everything at once.
        </p>
      </div>

      <section class="home__currently">
        <div class="currently-col">
          <a class="currently-label" href={`${BASE}library#books`}>Reading</a>
          <ul class="currently-list">
            {currently.reading.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="currently-col">
          <a class="currently-label" href={`${BASE}projects`}>Building</a>
          <ul class="currently-list">
            {currently.building.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="currently-col">
          <p class="currently-label">Seeking</p>
          <ul class="currently-list">
            {currently.seeking.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <div class="home__sections">

        <!-- Writing -->
        <section class="home__section">
          <div class="home__section-header">
            <span class="home__section-label">Writing</span>
            <a class="home__section-see-all" href={`${BASE}writing`}>See all &rarr;</a>
          </div>
          {featuredPosts.length > 0 ? (
            <ul class="article-list">
              {featuredPosts.map((post) => (
                <ArticleCard
                  id={post.id}
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.originalDate ?? post.data.date}
                  topics={post.data.topics}
                />
              ))}
            </ul>
          ) : (
            <p style="color: var(--text-muted); font-family: var(--sans); font-size: var(--size-sm);">
              No articles yet.
            </p>
          )}
        </section>

        <!-- Projects -->
        <section class="home__section">
          <div class="home__section-header">
            <span class="home__section-label">Projects</span>
            <a class="home__section-see-all" href={`${BASE}projects`}>See all &rarr;</a>
          </div>
          <div class="home__projects-mini">
            {featuredProjects.map((p) => (
              <div class="project-mini-card">
                <p class={`project-mini-card__status project-mini-card__status--${p.status}`}>
                  {p.status}
                </p>
                <h3 class="project-mini-card__name">
                  {p.url ? (
                    <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
                  ) : p.name}
                </h3>
                <p class="project-mini-card__desc">{p.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Bites -->
        {bites.length > 0 && (
          <section class="home__section">
            <div class="home__section-header">
              <span class="home__section-label">Bites</span>
              <a class="home__section-see-all" href={`${BASE}bites`}>See all &rarr;</a>
            </div>
            <ul class="bite-list">
              {bites.map((post) => (
                <li class="bite-item">
                  <p class="bite-item__title">
                    <a href={`${BASE}blog/${post.id}`}>{post.data.title}</a>
                  </p>
                  <p class="bite-item__date">{fmtShort(post.data.originalDate ?? post.data.date)}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

      </div>
    </section>
  </div>
</BaseLayout>
