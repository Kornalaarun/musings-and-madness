---
import { getCollection } from 'astro:content';
import { BASE } from '../../site.config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && !data.placeholder);
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = allPosts.filter((p) => !p.data.topics?.includes('bites'));
const bites = allPosts.filter((p) => p.data.topics?.includes('bites'));

function fmtShort(d: Date) {
  return d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>The Essayist — Sample Layout</title>
  <style>
    :root {
      --bg: #fffff8;
      --text: #111111;
      --muted: #999;
      --mid: #555;
      --accent: #222;
      --rule: #e8e5e0;
      --serif: Georgia, 'Times New Roman', serif;
      --sans: system-ui, -apple-system, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--serif);
      font-size: 1rem;
      line-height: 1.7;
      min-height: 100vh;
    }

    .wrap {
      max-width: 30rem;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ── Header ──────────────────────────────────── */
    .site-header {
      padding: 4rem 0 0;
      margin-bottom: 4rem;
    }

    .site-title {
      font-family: var(--serif);
      font-size: 0.875rem;
      font-weight: normal;
      font-variant: small-caps;
      letter-spacing: 0.06em;
      color: var(--text);
      text-decoration: none;
      display: block;
      margin-bottom: 2.5rem;
    }

    .site-nav {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }

    .site-nav a {
      font-family: var(--sans);
      font-size: 0.75rem;
      color: var(--muted);
      text-decoration: none;
      letter-spacing: 0.04em;
    }
    .site-nav a:hover { color: var(--text); }

    /* ── Section ─────────────────────────────────── */
    .section {
      margin-bottom: 3rem;
    }

    .section-title {
      font-family: var(--sans);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 400;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--rule);
    }

    /* ── Writing list ────────────────────────────── */
    .writing-list { list-style: none; }

    .writing-item {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--rule);
    }
    .writing-item:last-child { border-bottom: none; }

    .writing-title {
      font-size: 1rem;
      font-weight: normal;
      line-height: 1.4;
      flex: 1;
    }

    .writing-title a {
      color: var(--text);
      text-decoration: none;
    }
    .writing-title a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
    }

    .writing-date {
      font-family: var(--sans);
      font-size: 0.72rem;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ── Notes list ──────────────────────────────── */
    .notes-list { list-style: none; }

    .notes-item {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--rule);
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
    }
    .notes-item:last-child { border-bottom: none; }

    .notes-title {
      font-size: 0.9rem;
      font-style: italic;
    }
    .notes-title a {
      color: var(--mid);
      text-decoration: none;
    }
    .notes-title a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }

    .notes-date {
      font-family: var(--sans);
      font-size: 0.7rem;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* ── Footer ───────────────────────────────────── */
    .site-footer {
      padding: 4rem 0 5rem;
      border-top: 1px solid var(--rule);
      margin-top: 3rem;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer-copy {
      font-family: var(--sans);
      font-size: 0.72rem;
      color: var(--muted);
    }

    .footer-nav {
      display: flex;
      gap: 1.25rem;
      list-style: none;
    }
    .footer-nav a {
      font-family: var(--sans);
      font-size: 0.72rem;
      color: var(--muted);
      text-decoration: none;
    }
    .footer-nav a:hover { color: var(--text); }

    /* ── Back ─────────────────────────────────────── */
    .back {
      font-family: var(--sans);
      font-size: 0.7rem;
      color: var(--muted);
      text-decoration: none;
      display: block;
      margin-bottom: 2.5rem;
      padding-top: 1.5rem;
    }
    .back:hover { color: var(--text); }
  </style>
</head>
<body>
  <div class="wrap">
    <a class="back" href=".">&larr; samples</a>

    <header class="site-header">
      <a class="site-title" href="#">Musings and Madness</a>
      <nav>
        <ul class="site-nav">
          <li><a href="#">Home</a></li>
          <li><a href="#">Notes</a></li>
          <li><a href="#">About</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="section">
        <p class="section-title">Writing</p>
        <ul class="writing-list">
          {posts.map((post) => (
            <li class="writing-item">
              <h2 class="writing-title">
                <a href={`${BASE}blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <span class="writing-date">{fmtShort(post.data.originalDate ?? post.data.date)}</span>
            </li>
          ))}
        </ul>
      </section>

      {bites.length > 0 && (
        <section class="section">
          <p class="section-title">Notes</p>
          <ul class="notes-list">
            {bites.map((post) => (
              <li class="notes-item">
                <span class="notes-title">
                  <a href={`${BASE}blog/${post.id}`}>{post.data.title}</a>
                </span>
                <span class="notes-date">{fmtShort(post.data.originalDate ?? post.data.date)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-copy">&copy; {new Date().getFullYear()} Arun</span>
        <ul class="footer-nav">
          <li><a href="#">RSS</a></li>
          <li><a href="#">About</a></li>
        </ul>
      </div>
    </footer>
  </div>
</body>
</html>
