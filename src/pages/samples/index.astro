---
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Layout Samples — Musings and Madness</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #f0ede8;
      padding: 3rem 2rem;
      color: #1a1a1a;
      min-height: 100vh;
    }
    .header { max-width: 56rem; margin: 0 auto 3rem; }
    .header h1 {
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #888;
      font-weight: 500;
      margin-bottom: 0.5rem;
    }
    .header p { font-size: 0.875rem; color: #666; line-height: 1.6; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.25rem;
      max-width: 56rem;
      margin: 0 auto;
    }
    .card {
      background: white;
      border: 1px solid #ddd;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: transform 0.15s, box-shadow 0.15s;
      overflow: hidden;
    }
    .card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
    .preview {
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .preview-lab {
      background: #f7f4ee;
      background-image: repeating-linear-gradient(transparent, transparent 15px, #ddd5c4 15px, #ddd5c4 16px);
      color: #8a7a6a;
      font-family: 'Courier New', monospace;
    }
    .preview-essayist {
      background: #fffff8;
      color: #bbb;
      font-family: Georgia, serif;
      letter-spacing: 0.03em;
      font-style: italic;
      font-size: 0.75rem;
    }
    .preview-commonplace {
      background: #f6f1e8;
      color: #a08060;
      border-bottom: 1px solid #d8c9a8;
      font-family: Georgia, serif;
    }
    .preview-palace {
      background: #0a0a12;
      color: #c9a84c;
      font-family: Georgia, serif;
      letter-spacing: 0.15em;
    }
    .card-body { padding: 1.25rem 1.5rem 1.5rem; }
    .card-num {
      font-family: monospace;
      font-size: 0.65rem;
      color: #bbb;
      margin-bottom: 0.4rem;
    }
    .card-name { font-size: 1rem; font-weight: 600; color: #111; margin-bottom: 0.4rem; }
    .card-desc { font-size: 0.775rem; color: #777; line-height: 1.65; }
  </style>
</head>
<body>
  <div class="header">
    <h1>Layout Samples</h1>
    <p>Four directions for musingsandmadness.me — browse each, pick one to build.</p>
  </div>

  <div class="grid">
    <a class="card" href="lab-notebook">
      <div class="preview preview-lab">field log · entry 001</div>
      <div class="card-body">
        <div class="card-num">01</div>
        <div class="card-name">Lab Notebook</div>
        <div class="card-desc">Scientific log aesthetic. Ruled background, monospace metadata, numbered entries. Curious + scientific.</div>
      </div>
    </a>
    <a class="card" href="essayist">
      <div class="preview preview-essayist">the writing does the work</div>
      <div class="card-body">
        <div class="card-num">02</div>
        <div class="card-name">The Essayist</div>
        <div class="card-desc">Typography-only. Narrow column, no decoration. Reads like a literary table of contents.</div>
      </div>
    </a>
    <a class="card" href="commonplace">
      <div class="preview preview-commonplace">A personal commonplace book</div>
      <div class="card-body">
        <div class="card-num">03</div>
        <div class="card-name">Commonplace Book</div>
        <div class="card-desc">Warm parchment, shelved sections. Writing, notes, and reading as distinct streams.</div>
      </div>
    </a>
    <a class="card" href="mind-palace">
      <div class="preview preview-palace">◈ THE MIND PALACE ◈</div>
      <div class="card-body">
        <div class="card-num">04</div>
        <div class="card-name">Mind Palace</div>
        <div class="card-desc">Dark, immersive. Chambers of thought. Gold on deep navy. Cinematic and personal.</div>
      </div>
    </a>
  </div>
</body>
</html>
