---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE } from '../site.config';

const isDev = import.meta.env.DEV;

const posts = (await getCollection('blog', ({ data }) => isDev || (!data.draft && !data.placeholder)))
  .map((p) => ({ ...p, written: p.data.originalDate ?? p.data.date }))
  .sort((a, b) => b.written.valueOf() - a.written.valueOf());

// Grouped by the year a piece was written, not published: most of these
// sat in a notebook for years before they came here.
const years = [...new Set(posts.map((p) => p.written.getFullYear()))];
const byYear = years.map((y) => ({ year: y, posts: posts.filter((p) => p.written.getFullYear() === y) }));

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<BaseLayout title="Musings" description="Essays, bites, and book notes — mostly written for my future self.">
  <div class="container">
    <header class="page-head">
      <span class="hand">the thinking</span>
      <h1 class="page-head__title page-head__title--musings">Musings</h1>
      <p class="page-head__lede">
        Essays, bites, and book notes &mdash; mostly written for my future self.
        Many were written years before they were published here; they're filed
        by the year I wrote them.
      </p>
    </header>

    <div class="years">
      {byYear.map(({ year, posts }) => (
        <section class="year">
          <h2 class="year__label">{year}</h2>
          <ol class="entries">
            {posts.map((p) => {
              const bite = p.data.topics?.includes('bites');
              return (
                <li class:list={['entry', { 'entry--bite': bite }]}>
                  <a href={`${BASE}blog/${p.id}`}>
                    <span class="entry__title">{p.data.title}</span>
                    {bite && <span class="entry__kind">bite</span>}
                  </a>
                  <time class="entry__date" datetime={p.written.toISOString().slice(0, 10)}>{fmt(p.written)}</time>
                  {!bite && <p class="entry__desc">{p.data.description}</p>}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>

    {posts.length === 0 && <p class="entry__desc">Nothing here yet.</p>}

    <p class="crossover">
      The other half of this site is <a href={`${BASE}projects`}>Madness</a> &mdash; what these ideas turned into.
    </p>
  </div>
</BaseLayout>

<style>
  .years { padding-bottom: var(--space-12); }

  .year {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .year__label {
    font-family: var(--mono);
    font-size: var(--size-sm);
    color: var(--text-muted);
    padding-top: 0.35rem;
  }

  .entries { list-style: none; }
  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .entry a {
    text-decoration: none;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .entry a:hover .entry__title { color: var(--accent); }
  .entry__title { font-size: var(--size-xl); line-height: 1.35; }
  .entry--bite .entry__title { font-size: var(--size-lg); font-style: italic; }
  .entry__kind { font-family: var(--hand); font-size: 1.1rem; color: var(--accent); }
  .entry__date { font-family: var(--mono); font-size: 0.75rem; color: var(--text-muted); padding-top: 0.5rem; }
  .entry__desc {
    grid-column: 1 / -1;
    font-size: var(--size-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin-top: 0.15rem;
  }

  .crossover {
    max-width: none;
    border-top: 1px solid var(--border);
    padding-block: var(--space-8) var(--space-16);
    font-style: italic;
    color: var(--text-muted);
  }

  @media (max-width: 40rem) {
    .year { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
