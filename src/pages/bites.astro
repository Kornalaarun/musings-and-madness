---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE } from '../site.config';

const isDev = import.meta.env.DEV;

const bites = await getCollection('blog', ({ data }) => {
  if (data.draft && !isDev) return false;
  return data.topics?.includes('bites') ?? false;
});

bites.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Bites"
  description="Short reads — quick notes, reflections, and fragments."
>
  <div class="container">
    <section class="home">
      <div class="home__intro">
        <h1 class="home__title">Bites</h1>
        <p class="home__tagline">Short reads — quick notes, reflections, and fragments.</p>
      </div>

      <div>
        <ul class="article-list">
          {bites.map((post) => (
            <ArticleCard
              id={post.id}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              topics={post.data.topics}
            />
          ))}
        </ul>
        {bites.length === 0 && (
          <p style="color: var(--text-muted); font-family: var(--sans); font-size: var(--size-sm);">
            Nothing here yet.
          </p>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
